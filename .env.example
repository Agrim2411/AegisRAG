AEGIS_RAG_ENV=local
AEGIS_RAG_DATABASE_URL=sqlite:///./data/aegis_rag.db
AEGIS_RAG_EMBEDDING_DIMENSIONS=256
AEGIS_RAG_TOP_K=4
AEGIS_RAG_MAX_DOCUMENT_BYTES=2000000
AEGIS_RAG_LOG_LEVEL=INFO
# Optional production adapters (uncomment with `docker compose up`)
# AEGIS_RAG_QDRANT_URL=http://localhost:6333
# AEGIS_RAG_QDRANT_COLLECTION=aegis_incident_knowledge
# AEGIS_RAG_REDIS_URL=redis://localhost:6379/0
# AEGIS_RAG_OTEL_ENABLED=true
# AEGIS_RAG_OTEL_SERVICE_NAME=aegis-rag-api
# AEGIS_RAG_ANSWER_PROVIDER=openai
# AEGIS_RAG_LLM_MODEL=gpt-5-mini
# OPENAI_API_KEY=replace-me
